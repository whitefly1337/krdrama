# Copy to .env.local for development and to .env.native for the iOS build
# (`npm run cap:sync` builds with --mode native). Never commit real values.
# These are all public client values; secrets go into Supabase function secrets.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat → Project → API keys → App Store public key (appl_...)
VITE_REVENUECAT_IOS_KEY=

# AdMob → Apps → Ad units → Rewarded unit id (ca-app-pub-xxx/yyy)
VITE_ADMOB_REWARDED_IOS=
# true = request test ads (use while developing, never in the App Store build)
VITE_ADMOB_TESTING=true

# Shown in the app; App Store review requires working Privacy Policy and Terms links.
VITE_PRIVACY_URL=https://example.com/privacy
# Leave empty to use Apple's standard EULA
VITE_TERMS_URL=
VITE_SUPPORT_EMAIL=support@example.com
