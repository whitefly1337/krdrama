{
  "name": "CoinTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User"
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "earned",
        "spent"
      ],
      "default": "earned"
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "enum": [
        "ad_reward",
        "episode_unlock"
      ]
    },
    "ref_id": {
      "type": "string",
      "title": "Reference ID"
    }
  },
  "required": [
    "user_id",
    "amount",
    "type",
    "reason"
  ]
}