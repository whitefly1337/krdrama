{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c"
    },
    "status": {
      "type": "string",
      "title": "\u0421\u0442\u0430\u0442\u0443\u0441",
      "enum": [
        "active",
        "cancelled",
        "expired"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "title": "\u0422\u0430\u0440\u0438\u0444",
      "enum": [
        "monthly"
      ],
      "default": "monthly"
    },
    "start_date": {
      "type": "string",
      "title": "\u041d\u0430\u0447\u0430\u043b\u043e",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "title": "\u041e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0435",
      "format": "date"
    }
  },
  "required": [
    "user_id",
    "status"
  ]
}