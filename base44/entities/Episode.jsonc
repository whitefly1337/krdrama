{
  "name": "Episode",
  "type": "object",
  "properties": {
    "series_id": {
      "type": "string",
      "title": "\u0421\u0435\u0440\u0438\u0430\u043b"
    },
    "title": {
      "type": "string",
      "title": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0440\u0438\u0438"
    },
    "episode_number": {
      "type": "number",
      "title": "\u041d\u043e\u043c\u0435\u0440 \u0441\u0435\u0440\u0438\u0438",
      "default": 1
    },
    "video_url": {
      "type": "string",
      "title": "\u0412\u0438\u0434\u0435\u043e (URL)",
      "format": "uri"
    },
    "thumbnail_url": {
      "type": "string",
      "title": "\u041f\u0440\u0435\u0432\u044c\u044e",
      "format": "uri"
    },
    "duration": {
      "type": "number",
      "title": "\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c (\u0441\u0435\u043a)",
      "default": 0
